    <p  class="man-p"  data-t="mx">Jog-A existe para darte las herramientas que antes solo tenían las grandes empresas. Ahora son tuyas.</p>
    <a href="#products" class="btn-gold" data-t="mc">COMENZAR AHORA</a>
  </section>

  <footer>
    <img src="logo.png" alt="Jog-A" class="flogo" onerror="this.style.display='none'">
    <p class="fsub" data-t="fc">© 2025 Jog-A Universe · Todos los derechos reservados</p>
  </footer>

</div>

<script>
var S={
  es:{np:"Aplicaciones",na:"Filosofía",he:"Bienvenido al Universo",hw:"Universe",
    hd:"Una plataforma de crecimiento personal impulsada por inteligencia artificial. 10 herramientas. Un solo universo.",
    ce:"EXPLORAR APPS",ca:"CONOCER MÁS",sa:"APLICACIONES",sl:"EN VIVO",sp:"POTENCIAL",
