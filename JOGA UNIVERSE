  {i:"🌐",live:false,url:"#",es:{n:"Website",d:""},en:{n:"Website",d:""}},
  {i:"🖼️",live:false,url:"#",es:{n:"Wallpaper",d:""},en:{n:"Wallpaper",d:""}},
  {i:"🤖",live:false,url:"#",es:{n:"Coach",d:""},en:{n:"Coach",d:""}}
];
function gl(){return localStorage.getItem('jiLang')||'es'}
function t(k){var l=gl();return(S[l]&&S[l][k])||S.es[k]||k}
function toggleLang(){localStorage.setItem('jiLang',gl()==='es'?'en':'es');apply()}
function apply(){
  document.querySelectorAll('[data-t]').forEach(function(e){e.textContent=t(e.getAttribute('data-t'))});
  document.getElementById('lt').textContent=gl()==='es'?'EN':'ES';
  render();
}
function render(){
  var live=P.filter(function(p){return p.live});
  var coming=P.filter(function(p){return !p.live});
  var lang=gl();
  var h=live.map(function(p){
    return '<a href="'+p.url+'" class="card" target="_blank">'+
      '<span class="cicon">'+p.i+'</span>'+
      '<span class="badge bl">'+t('bl')+'</span>'+
      '<div class="ctit"><span class="gw">Jog-A</span> '+p[lang].n+'</div>'+
      '<p class="cdesc">'+p[lang].d+'</p>'+
      '<span class="carr">→</span></a>';
  }).join('');
  h+='<div class="card wip">'+
    '<span class="cicon">🔭</span>'+
    '<div class="ctit" style="font-size:22px">'+t('cm')+'</div>'+
    '<p class="cdesc" style="margin-top:14px">'+coming.map(function(p){return 'Jog-A '+p[lang].n}).join(' · ')+'</p>'+
    '<p class="cdesc" style="margin-top:10px">'+t('cd')+'</p></div>';
  document.getElementById('grid').innerHTML=h;
}

// ── STARFIELD ──
(function(){
  var c=document.getElementById('starfield');
  var ctx=c.getContext('2d');
  var W,H;
  function rsz(){W=c.width=window.innerWidth;H=c.height=window.innerHeight}
  rsz();window.addEventListener('resize',rsz);
  var scrollY=0;
  window.addEventListener('scroll',function(){scrollY=window.scrollY});

  // 1400 stars
  var stars=[];
  for(var i=0;i<1400;i++){
    stars.push({
      x:Math.random(),y:Math.random(),
      r:Math.random()*1.6+0.15,
      a:Math.random()*0.55+0.35,
      gold:Math.random()<0.09,
      sp:Math.random()*0.03+0.008,
      off:Math.random()*6.28
    });
  }

  // Nebulas
  var neb=[
    {x:.78,y:.22,r:.26,c:'rgba(139,111,212,.09)'},
    {x:.12,y:.40,r:.20,c:'rgba(34,211,238,.06)'},
    {x:.50,y:.62,r:.30,c:'rgba(201,168,76,.07)'},
    {x:.88,y:.56,r:.18,c:'rgba(139,111,212,.055)'},
    {x:.36,y:.14,r:.22,c:'rgba(34,211,238,.04)'},
  ];

  var tick=0;
  function loop(){
    requestAnimationFrame(loop);
    tick+=0.007;
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#060608';ctx.fillRect(0,0,W,H);

    // Subtle center glow
    var g=ctx.createRadialGradient(W*.5,H*.3,0,W*.5,H*.3,W*.55);
    g.addColorStop(0,'rgba(18,12,32,.45)');g.addColorStop(1,'transparent');
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);

    // Nebulas
    neb.forEach(function(n){
      var g2=ctx.createRadialGradient(n.x*W,n.y*H,0,n.x*W,n.y*H,n.r*W);
      g2.addColorStop(0,n.c);g2.addColorStop(1,'transparent');
      ctx.fillStyle=g2;ctx.fillRect(0,0,W,H);
    });

    // Stars
    for(var i=0;i<stars.length;i++){
      var s=stars[i];
      var tw=0.3+0.7*Math.abs(Math.sin(tick*s.sp*10+s.off));
      ctx.globalAlpha=s.a*tw;
      if(s.gold){ctx.fillStyle='#E8C97A';ctx.shadowBlur=6;ctx.shadowColor='#C9A84C';}
      else{ctx.fillStyle='#fff';ctx.shadowBlur=0;}
      ctx.beginPath();ctx.arc(s.x*W,s.y*H-scrollY*.022,s.r,0,6.28);ctx.fill();
      ctx.shadowBlur=0;
    }
    ctx.globalAlpha=1;

    // Shooting star
    var st=(tick*.13)%1;
    if(st<.28){
      var p=st/.28,sx=W*.08+p*W*.44,sy=H*.04+p*H*.12;
      ctx.save();ctx.globalAlpha=Math.sin(p*3.14)*.92;
      var sg=ctx.createLinearGradient(sx-88,sy-28,sx,sy);
      sg.addColorStop(0,'transparent');sg.addColorStop(1,'#E8C97A');
      ctx.strokeStyle=sg;ctx.lineWidth=1.8;
      ctx.beginPath();ctx.moveTo(sx-88,sy-28);ctx.lineTo(sx,sy);ctx.stroke();
      ctx.fillStyle='#E8C97A';ctx.shadowBlur=12;ctx.shadowColor='#C9A84C';
      ctx.beginPath();ctx.arc(sx,sy,2.3,0,6.28);ctx.fill();
      ctx.restore();
    }
  }
  loop();
})();

apply();
</script>
