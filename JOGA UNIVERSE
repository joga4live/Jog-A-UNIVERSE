    mc:"START NOW",fc:"© 2025 Jog-A Universe · All rights reserved",
    bl:"LIVE",cm:"Coming Soon",cd:"More Jog-A universe tools arriving soon."}
};
var P=[
  {i:"📚",live:true,url:"https://joga4live.github.io/Joga-Books/",
   es:{n:"Books",d:"Biblioteca de libros con IA para tu crecimiento personal."},
   en:{n:"Books",d:"AI-powered book library for your personal growth."}},
  {i:"🖼️",live:true,url:"https://joga4live.github.io/joga-covers/",
   es:{n:"Covers",d:"Editor profesional de portadas y galería visual."},
   en:{n:"Covers",d:"Professional cover editor and visual identity gallery."}},
  {i:"🧠",live:true,url:"https://joga4live.github.io/joga-intelligence/",
   es:{n:"Intelligence",d:"Tu plataforma central de crecimiento personal con 7 apps integradas."},
   en:{n:"Intelligence",d:"Your central personal growth platform with 7 integrated apps."}},
  {i:"🎧",live:true,url:"https://joga4live.github.io/joga-audio/",
   es:{n:"Audio",d:"Audiolibros narrados por IA. Aprende escuchando en cualquier momento."},
