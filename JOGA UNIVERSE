<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jog-A Universe</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --void:#060608;--dark2:#141218;
      --gold:#C9A84C;--goldb:#E8C97A;--golddim:rgba(201,168,76,.15);--goldbdr:rgba(201,168,76,.25);
      --cream:#F7F3EC;
      --txt:#F1EDE4;--txt2:#B8AA97;--txt3:#6B5F4F;
      --bdr:rgba(255,255,255,.06);
      --sans:'Space Grotesk',system-ui,sans-serif;
      --serif:'Playfair Display',Georgia,serif;
    }
    html{scroll-behavior:smooth}
    body{background:var(--void);color:var(--txt);font-family:var(--sans);overflow-x:hidden}

    /* ── LAYER STACK ── */
    #starfield{position:fixed;inset:0;width:100%;height:100%;z-index:0}

    /* ── PLANET LAYER — real NASA photos ── */
    #planets{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}

    /* ANIMATIONS */
    @keyframes earth-spin{from{transform:translateX(0)}to{transform:translateX(-50%)}}

    @keyframes float-slow{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(-22px) rotate(-1.5deg)}}
    @keyframes float-mid {0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
    @keyframes float-fast{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.2;transform:scale(1.9)}}
    @keyframes logo-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}

    /* ── SATURN (real Cassini photo — rings included) ── */
    .saturn{
      position:absolute;left:-4%;top:1%;
      width:clamp(200px,28vw,500px);
      animation:float-slow 16s ease-in-out infinite;
    }
    .saturn img{
      width:100%;height:auto;display:block;
      filter:drop-shadow(0 0 clamp(15px,2.5vw,55px) rgba(210,180,90,.45))
             drop-shadow(0 0 clamp(30px,5vw,100px) rgba(180,140,60,.18));
    }

    /* ── EARTH (rotating NASA texture + atmosphere) ── */
    .earth-system{
      position:absolute;right:5%;top:9%;
      width:clamp(150px,20vw,340px);
      height:clamp(150px,20vw,340px);
      animation:float-mid 14s ease-in-out infinite 0.5s;
    }
    /* Outer atmosphere glow */
    .earth-atmo{
      position:absolute;inset:-4%;border-radius:50%;
      box-shadow:0 0 clamp(15px,2.5vw,50px) rgba(80,160,255,.55),
                 inset 0 0 clamp(12px,2vw,35px) rgba(80,160,255,.22);
    }
    /* Sphere + rotating texture */
    .earth-sphere{
      position:absolute;inset:0;border-radius:50%;overflow:hidden;
      box-shadow:0 0 clamp(20px,3vw,65px) rgba(50,120,255,.42),
                 0 0 clamp(40px,6vw,120px) rgba(30,80,200,.2);
    }
    .earth-tex{
      position:absolute;width:200%;height:100%;left:0;top:0;
      background-image:url('https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Whole_world_-_land_and_oceans_12000.jpg/1280px-Whole_world_-_land_and_oceans_12000.jpg');
      background-size:50% 100%;background-repeat:repeat-x;
      animation:earth-spin 36s linear infinite;
    }
    /* Lighting: dark side shadow */
    .earth-shadow{
      position:absolute;inset:0;border-radius:50%;
      background:radial-gradient(circle at 28% 30%, transparent 16%, rgba(0,0,12,.90) 100%);
    }
    /* Specular highlight */
    .earth-spec{
      position:absolute;inset:0;border-radius:50%;
      background:radial-gradient(circle at 35% 28%, rgba(180,210,255,.18) 0%, transparent 45%);
    }

    /* ── MOON ── */


    /* ── MARS ── */
    .mars-system{
      position:absolute;right:27%;top:3%;
      width:clamp(52px,6vw,105px);
      height:clamp(52px,6vw,105px);
      animation:float-fast 9s ease-in-out infinite 2s;
    }
    .mars-sphere{
      position:absolute;inset:0;border-radius:50%;overflow:hidden;
      box-shadow:0 0 clamp(8px,1.5vw,24px) rgba(200,80,40,.52);
    }
    .mars-sphere img{width:100%;height:100%;object-fit:cover;display:block}
    .mars-shadow{
      position:absolute;inset:0;border-radius:50%;
      background:radial-gradient(circle at 30% 32%, transparent 18%, rgba(0,0,0,.86) 100%);
    }

    /* ── OVERLAY gradient (planets visible above, content below) ── */
    .overlay{
      position:fixed;inset:0;z-index:2;pointer-events:none;
      background:linear-gradient(to bottom,
        rgba(6,6,8,0.00) 0%,
        rgba(6,6,8,0.04) 28%,
        rgba(6,6,8,0.52) 62%,
        rgba(6,6,8,0.95) 100%);
    }

    /* ── CONTENT ── */
    .content{position:relative;z-index:10}

    /* NAV */
    nav{
      position:fixed;top:0;left:0;right:0;z-index:200;
      display:flex;justify-content:space-between;align-items:center;
      padding:18px 52px;
      background:rgba(6,6,8,.26);backdrop-filter:blur(22px);
      border-bottom:1px solid var(--goldbdr);
    }
    .nav-logo{height:36px;width:auto;filter:drop-shadow(0 0 12px rgba(201,168,76,.5))}
    .nav-links{display:flex;gap:36px;align-items:center}
    .nav-link{font-size:13px;font-weight:500;color:var(--txt2);text-decoration:none;transition:color .3s}
    .nav-link:hover{color:var(--gold)}
    .lang-btn{
      background:transparent;border:1px solid var(--goldbdr);color:var(--gold);
      padding:8px 20px;border-radius:6px;cursor:pointer;font-family:var(--sans);
      font-size:12px;font-weight:700;letter-spacing:1.5px;transition:all .3s;
    }
    .lang-btn:hover{background:var(--golddim)}

    /* HERO */
    .hero{
      min-height:100vh;display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      text-align:center;padding:140px 48px 100px;
    }
    .hero-logo{
      width:clamp(100px,13vw,190px);margin-bottom:24px;
      filter:drop-shadow(0 0 55px rgba(201,168,76,.68));
      animation:logo-float 5s ease-in-out infinite;
    }
    .hero-eyebrow{
      display:inline-flex;align-items:center;gap:10px;
      font-size:11px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;
      color:var(--gold);border:1px solid var(--goldbdr);background:rgba(201,168,76,.06);
      padding:10px 24px;border-radius:100px;margin-bottom:34px;
    }
    .hero-eyebrow::before{
      content:'';width:6px;height:6px;border-radius:50%;
      background:var(--gold);box-shadow:0 0 10px rgba(201,168,76,.9);
      animation:pulse 2s infinite;
    }
    .hero-title{
      font-size:clamp(90px,14vw,178px);font-weight:900;line-height:.87;letter-spacing:-6px;
      background:linear-gradient(145deg,var(--goldb) 0%,var(--gold) 55%,#F0E8D0 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;
      margin-bottom:8px;filter:drop-shadow(0 0 80px rgba(201,168,76,.34));
    }
    .hero-sub{
      font-size:clamp(26px,3.5vw,58px);font-weight:300;font-family:var(--serif);
      font-style:italic;color:var(--txt2);letter-spacing:-1px;margin-bottom:34px;
    }
    .hero-desc{max-width:540px;font-size:19px;line-height:1.78;color:var(--txt2);margin-bottom:52px;font-weight:300}
    .hero-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
    .btn-gold{
      background:var(--gold);color:#060608;padding:20px 48px;border-radius:8px;
      font-size:13px;font-weight:800;letter-spacing:1.8px;text-decoration:none;
      box-shadow:0 0 64px rgba(201,168,76,.48),0 8px 32px rgba(0,0,0,.4);
      transition:all .35s;border:none;cursor:pointer;display:inline-block;
    }
    .btn-gold:hover{box-shadow:0 0 120px rgba(201,168,76,.78),0 12px 40px rgba(0,0,0,.5);transform:translateY(-3px)}
    .btn-outline{
      background:transparent;color:var(--goldb);padding:20px 48px;border-radius:8px;
      font-size:13px;font-weight:700;letter-spacing:1px;text-decoration:none;
      border:1px solid var(--goldbdr);transition:all .3s;display:inline-block;
    }
    .btn-outline:hover{background:var(--golddim)}
    .hero-stats{display:flex;gap:80px;justify-content:center;margin-top:88px;flex-wrap:wrap}
    .stat{text-align:center}
    .stat-n{
      font-size:64px;font-weight:900;line-height:1;
      background:linear-gradient(135deg,var(--gold),var(--goldb));
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;
      filter:drop-shadow(0 0 28px rgba(201,168,76,.55));
    }
    .stat-l{font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--txt3);margin-top:8px}

    /* PRODUCTS */
    .products-section{padding:140px 48px;background:rgba(6,6,8,.90);backdrop-filter:blur(60px)}
    .sec-in{max-width:1240px;margin:0 auto}
    .sec-eye{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:18px}
    .sec-h{font-size:clamp(48px,6vw,92px);font-weight:900;letter-spacing:-3px;line-height:.93;color:var(--txt);margin-bottom:16px}
    .sec-h em{font-style:normal;background:linear-gradient(135deg,var(--gold),var(--goldb));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .sec-sub{font-size:18px;color:var(--txt2);max-width:500px;line-height:1.65;margin-bottom:72px;font-weight:300}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px}
    .card{
      background:var(--dark2);border:1px solid var(--bdr);border-radius:20px;padding:36px;
      text-decoration:none;color:var(--txt);transition:all .4s cubic-bezier(.16,1,.3,1);
      position:relative;overflow:hidden;display:block;
    }
    .card::before{
      content:'';position:absolute;top:0;left:0;right:0;height:2px;
      background:linear-gradient(90deg,transparent,var(--gold),transparent);
      opacity:0;transition:opacity .4s;border-radius:20px 20px 0 0;
    }
    .card:hover{border-color:var(--goldbdr);transform:translateY(-8px);box-shadow:0 24px 80px rgba(0,0,0,.5),0 0 60px rgba(201,168,76,.07)}
    .card:hover::before{opacity:1}
    .card.wip{opacity:.44;cursor:default}
    .card.wip:hover{transform:none;box-shadow:none;border-color:var(--bdr)}
    .card.wip:hover::before{opacity:0}
    .cicon{font-size:38px;margin-bottom:20px;display:block}
    .badge{display:inline-block;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:18px}
    .bl{background:rgba(201,168,76,.12);color:var(--gold);border:1px solid var(--goldbdr)}
    .bw{background:rgba(255,255,255,.04);color:var(--txt3);border:1px solid var(--bdr)}
    .ctit{font-size:26px;font-weight:800;letter-spacing:-.5px;margin-bottom:12px;line-height:1.1}
    .ctit .gw{background:linear-gradient(135deg,var(--gold),var(--goldb));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .cdesc{font-size:14px;color:var(--txt2);line-height:1.65;font-weight:300}
    .carr{position:absolute;bottom:32px;right:32px;color:var(--gold);font-size:18px;font-weight:700;opacity:0;transform:translateX(-10px);transition:all .35s}
    .card:not(.wip):hover .carr{opacity:1;transform:translateX(0)}

    /* MANIFESTO */
    .manifesto{padding:160px 48px;background:var(--cream);text-align:center}
    .man-eye{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:18px}
    .man-h{font-size:clamp(40px,5.5vw,80px);font-weight:900;color:#1A1712;letter-spacing:-2.5px;line-height:1.06;max-width:840px;margin:0 auto 26px}
    .man-p{font-size:19px;color:#5C4E3A;max-width:560px;margin:0 auto 50px;line-height:1.78;font-weight:300}
    .manifesto .btn-gold{box-shadow:0 0 40px rgba(201,168,76,.28),0 8px 24px rgba(0,0,0,.15)}

    /* FOOTER */
    footer{padding:72px 48px;background:rgba(6,6,8,.98);text-align:center;border-top:1px solid var(--goldbdr)}
    .flogo{height:54px;margin-bottom:14px;filter:drop-shadow(0 0 24px rgba(201,168,76,.3))}
    .fsub{font-size:13px;color:var(--txt3);font-weight:300}
  </style>
</head>
<body>

<!-- LAYER 0: starfield -->
